# Base URL of the Transfermarkt site to scrape.
TRANSFERMARKT_BASE_URL=https://www.transfermarkt.com

# The ID of the ONE existing Google Spreadsheet to keep in sync.
# Found in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=

# The full JSON of a Google service account key, as a single line.
# The service account must be shared on the target spreadsheet with Editor access.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Delay between outbound requests to Transfermarkt, in milliseconds.
REQUEST_DELAY_MS=1500

# Playwright navigation timeout, in milliseconds.
NAVIGATION_TIMEOUT_MS=30000

# Number of retry attempts for a failed scrape request.
MAX_RETRIES=3
